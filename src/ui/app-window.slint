import { Button, VerticalBox, HorizontalBox } from "std-widgets.slint";
import { ScaleView, ScaleNoteItem, ScaleRowItem } from "views/scale_view.slint";
import { CircleView } from "views/circle_view.slint";
import { HarmonicFieldView, ChordItem, HarmonicRowItem } from "views/harmonic_field_view.slint";

export component AppWindow inherits Window {
    title: "Music Theory";
    icon: @image-url("../../assets/music-theory-rs.png");
    background: #18181b;

    preferred-width: 900px;
    preferred-height: 600px;
    min-width: 320px;
    min-height: 400px;

    property <bool> is-portrait: root.width < 600px;

    in-out property <string> current-view: "scales";
    
    in-out property <[string]> available-roots: [
        "All Roots", "C", "G", "D", "A", "E", "B", "F#", "C#",
        "F", "Bb", "Eb", "Ab", "Db", "Gb", "Cb"
    ];
    in-out property <string> selected-root: "C";
    
    in-out property <[string]> available-scales: [];
    in-out property <int> selected-scale-idx: 0;
    in-out property <[ScaleNoteItem]> scale-notes: [];
    in-out property <bool> is-all-roots-mode: false;
    in-out property <[ScaleRowItem]> all-scale-rows: [];

    in-out property <[string]> available-harmonic-scales: [];
    in-out property <int> selected-harmonic-scale-idx: 0;
    in-out property <[ChordItem]> harmonic-chords: [];
    in-out property <bool> is-all-harmonic-mode: false;
    in-out property <[HarmonicRowItem]> all-harmonic-rows: [];

    in-out property <angle> circle-rotation: 0deg;

    callback update-scale();
    callback update-harmonic-field();
    callback change-view(string);
    callback play-note(string);
    callback play-scale-sequence();
    callback circle-drag-event(float, float, float, float, bool);

    Rectangle {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;

        VerticalBox {
            width: parent.width;
            height: parent.height;

            padding-top: root.safe-area-insets.top + 24px;
            padding-bottom: root.safe-area-insets.bottom + 24px;
            padding-left: root.safe-area-insets.left + 24px;
            padding-right: root.safe-area-insets.right + 24px;

            spacing: 20px;

            if !root.is-portrait: HorizontalBox {
                spacing: 16px;
                alignment: start;
                padding: 0;

                Button {
                    width: 140px;
                    height: 36px;
                    text: "Scales Explorer";
                    clicked => { root.change-view("scales"); }
                }
                Button {
                    width: 140px;
                    height: 36px;
                    text: "Harmonic Field";
                    clicked => { root.change-view("harmonic"); }
                }
                Button {
                    width: 180px;
                    height: 36px;
                    text: "Circle of Fifths";
                    clicked => { root.change-view("circle"); }
                }
            }

            if root.is-portrait: VerticalBox {
                spacing: 12px;
                padding: 0;

                Button {
                    height: 44px;
                    text: "Scales Explorer";
                    clicked => { root.change-view("scales"); }
                }
                Button {
                    height: 44px;
                    text: "Harmonic Field";
                    clicked => { root.change-view("harmonic"); }
                }
                Button {
                    height: 44px;
                    text: "Circle of Fifths / Fourths";
                    clicked => { root.change-view("circle"); }
                }
            }

            Rectangle {
                height: 1px;
                background: #27272a;
            }

            if root.current-view == "scales": ScaleView {
                is-portrait: root.is-portrait;
                available-roots: root.available-roots;
                available-scales: root.available-scales;
                selected-root <=> root.selected-root;
                selected-scale-idx <=> root.selected-scale-idx;
                scale-notes: root.scale-notes;
                is-all-roots-mode <=> root.is-all-roots-mode;
                all-scale-rows <=> root.all-scale-rows;
                update-scale => { root.update-scale(); }
                play-note(note) => { root.play-note(note); }
                play-scale-sequence => { root.play-scale-sequence(); }
            }

            if root.current-view == "circle": CircleView {
                rotation-offset: root.circle-rotation;
                drag-event(mx, my, cx, cy, pressed) => {
                    root.circle-drag-event(mx, my, cx, cy, pressed);
                }
                play-note(note) => { root.play-note(note); }
            }

            if root.current-view == "harmonic": HarmonicFieldView {
                is-portrait: root.is-portrait;
                available-roots: root.available-roots;
                
                available-scales: root.available-harmonic-scales;
                selected-scale-idx <=> root.selected-harmonic-scale-idx;
                is-all-mode <=> root.is-all-harmonic-mode;
                all-rows: root.all-harmonic-rows;
                chords: root.harmonic-chords;
                
                selected-root <=> root.selected-root;
                update-field => { root.update-harmonic-field(); }
                play-chord(name) => { /* SOON */ }
            }
        }
    }
}