import { VerticalBox } from "std-widgets.slint";

export component NoteCard inherits Rectangle {
    in property <string> degree: "I";
    in property <string> note: "C";
    in property <bool> is-active: false;

    width: 80px;
    height: 100px;
    background: root.is-active ? #0284c7 : #27272a;
    border-radius: 8px;
    border-width: root.is-active ? 2px : 1px;
    border-color: root.is-active ? #38bdf8 : #3f3f46;
    animate background { duration: 100ms; }
    animate border-color { duration: 100ms; }

    VerticalBox {
        alignment: center;
        spacing: 8px;
        padding: 4px;

        Text {
            text: root.degree;
            color: root.is-active ? #ffffff : #a1a1aa;
            font-size: 13px;
            horizontal-alignment: center;
        }

        Text {
            text: root.note;
            color: root.is-active ? #ffffff : #38bdf8;
            font-size: 15px;
            font-weight: 700;
            horizontal-alignment: center;
        }
    }
}
