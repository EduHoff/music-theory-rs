import { VerticalBox } from "std-widgets.slint";

export component ScaleCard inherits Rectangle {
    in property <string> degree: "I";
    in property <string> note: "C";

    width: 80px;
    height: 100px;
    background: #27272a;
    border-radius: 8px;
    border-width: 1px;
    border-color: #3f3f46;

    VerticalBox {
        alignment: center;
        spacing: 8px;
        padding: 8px;

        Text {
            text: root.degree;
            color: #a1a1aa;
            font-size: 13px;
            horizontal-alignment: center;
        }

        Text {
            text: root.note;
            color: #38bdf8;
            font-size: 22px;
            font-weight: 700;
            horizontal-alignment: center;
        }
    }
}
