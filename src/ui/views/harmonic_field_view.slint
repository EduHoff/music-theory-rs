import { Button, VerticalBox, HorizontalBox, ComboBox, ScrollView } from "std-widgets.slint";
import { ChordCard } from "../components/chord_card.slint";

export struct ChordItem {
    degree: string,
    chord-name: string,
    notes-string: string,
    is-active: bool,
}

export struct HarmonicRowItem {
    root: string,
    chords: [ChordItem],
}

export component HarmonicFieldView inherits VerticalBox {
    in property <bool> is-portrait;
    in property <[string]> available-roots;
    in property <[string]> available-scales;

    in-out property <string> selected-root;
    in-out property <int> selected-scale-idx;

    in property <[ChordItem]> chords;
    in property <bool> is-all-mode;
    in property <[HarmonicRowItem]> all-rows;

    property <int> active-all-row: -1;
    property <int> active-all-col: -1;

    callback update-field();
    callback play-chord(int, string);
    callback play-harmonic-sequence();

    padding: 0;
    spacing: 20px;

    Timer {
        interval: 550ms;
        running: root.active-all-row >= 0;
        triggered => {
            root.active-all-row = -1;
            root.active-all-col = -1;
        }
    }

    if !root.is-portrait: HorizontalBox {
        vertical-stretch: 0;
        spacing: 16px;
        alignment: start;
        padding: 0;

        ComboBox {
            width: 120px;
            model: root.available-roots;
            current-value: root.selected-root;
            selected(value) => {
                root.selected-root = value;
                root.update-field();
            }
        }

        ComboBox {
            width: 220px;
            model: root.available-scales;
            current-index: root.selected-scale-idx;
            selected => {
                root.selected-scale-idx = self.current-index;
                root.update-field();
            }
        }

        if !root.is-all-mode: Button {
            height: 32px;
            text: "Play Field";
            clicked => { root.play-harmonic-sequence(); }
        }
    }

    if root.is-portrait: VerticalBox {
        vertical-stretch: 0;
        spacing: 12px;
        padding: 0;

        ComboBox {
            model: root.available-roots;
            current-value: root.selected-root;
            selected(value) => {
                root.selected-root = value;
                root.update-field();
            }
        }

        ComboBox {
            model: root.available-scales;
            current-index: root.selected-scale-idx;
            selected => {
                root.selected-scale-idx = self.current-index;
                root.update-field();
            }
        }

        if !root.is-all-mode: Button {
            height: 44px;
            text: "Play Field";
            clicked => { root.play-harmonic-sequence(); }
        }
    }

    ScrollView {
        vertical-stretch: 1;

        VerticalBox {
            alignment: start;
            padding: 0;

            if !root.is-all-mode: HorizontalBox {
                alignment: start;
                spacing: 16px;
                padding: 0;

                for chord[index] in root.chords: ChordCard {
                    degree: chord.degree;
                    chord-name: chord.chord-name;
                    notes-string: chord.notes-string;
                    is-active: chord.is-active;
                    clicked => { root.play-chord(index, chord.notes-string); }
                }
            }

            if root.is-all-mode: VerticalBox {
                spacing: 16px;
                alignment: start;
                padding: 0;

                for row[row_idx] in root.all-rows: HorizontalBox {
                    spacing: 16px;
                    alignment: start;
                    padding: 0;

                    Text {
                        text: row.root;
                        font-size: 20px;
                        color: white;
                        font-weight: 700;
                        vertical-alignment: center;
                        width: 40px;
                    }

                    for chord[col_idx] in row.chords: ChordCard {
                        compact: true;
                        degree: chord.degree;
                        chord-name: chord.chord-name;
                        notes-string: chord.notes-string;
                        is-active: root.active-all-row == row_idx && root.active-all-col == col_idx;
                        clicked => {
                            root.active-all-row = row_idx;
                            root.active-all-col = col_idx;
                            root.play-chord(-1, chord.notes-string);
                        }
                    }
                }
            }
        }
    }
}