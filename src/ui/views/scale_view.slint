import { ComboBox, VerticalBox, HorizontalBox, Button } from "std-widgets.slint";
import { NoteCard } from "../components/note_card.slint";

export struct ScaleNoteItem {
    degree: string,
    note: string,
    is-active: bool,
}

export struct ScaleRowItem {
    scale_name: string,
    notes: [ScaleNoteItem],
}

export component ScaleView inherits VerticalBox {
    in property <bool> is-portrait;

    in-out property <[string]> available-roots: [];
    in-out property <[string]> available-scales: [];
    in-out property <string> selected-root: "";
    in-out property <int> selected-scale-idx: 0;
    in-out property <[ScaleNoteItem]> scale-notes: [];
    in-out property <bool> is-all-roots-mode: false;
    in-out property <[ScaleRowItem]> all-scale-rows: [];

    property <int> active-all-row: -1;
    property <int> active-all-col: -1;

    callback update-scale();
    callback play-note(string);
    callback play-scale-sequence();

    padding: 0;
    spacing: 16px;

    Timer {
        interval: 350ms;
        running: root.active-all-row >= 0;
        triggered => {
            root.active-all-row = -1;
            root.active-all-col = -1;
        }
    }

    if !root.is-portrait: HorizontalBox {
        vertical-stretch: 0;
        spacing: 30px;
        alignment: space-between;
        padding: 0;

        Text {
            text: "Scale & Mode Explorer";
            color: #f4f4f5;
            font-size: 20px;
            font-weight: 700;
            vertical-alignment: center;
        }

        HorizontalBox {
            spacing: 20px;
            alignment: end;
            padding: 0;

            Rectangle {
                width: 150px;
                height: 50px;
                VerticalBox {
                    spacing: 4px;
                    padding: 0px;
                    Text { text: "Root Note"; color: #a1a1aa; font-size: 11px; }
                    ComboBox {
                        model: root.available-roots;
                        current-value <=> root.selected-root;
                        selected => { root.update-scale(); }
                    }
                }
            }

            Rectangle {
                width: 220px;
                height: 50px;
                VerticalBox {
                    spacing: 4px;
                    padding: 0px;
                    Text { text: "Scale Type"; color: #a1a1aa; font-size: 11px; }
                    ComboBox {
                        model: root.available-scales;
                        current-index <=> root.selected-scale-idx;
                        selected => { root.update-scale(); }
                    }
                }
            }

            if !root.is-all-roots-mode: VerticalBox {
                alignment: end;
                padding: 0;
                padding-bottom: 2px;
                Button {
                    height: 32px;
                    text: "Play Scale";
                    clicked => { root.play-scale-sequence(); }
                }
            }
        }
    }

    if root.is-portrait: VerticalBox {
        vertical-stretch: 0;
        spacing: 20px;
        padding: 0;
        alignment: start;

        Text {
            text: "Scale & Mode Explorer";
            color: #f4f4f5;
            font-size: 20px;
            font-weight: 700;
            horizontal-alignment: center;
        }

        VerticalBox {
            spacing: 16px;
            padding: 0;

            Rectangle {
                height: 50px;
                VerticalBox {
                    spacing: 4px;
                    padding: 0;
                    Text { text: "Root Note"; color: #a1a1aa; font-size: 11px; }
                    ComboBox {
                        model: root.available-roots;
                        current-value <=> root.selected-root;
                        selected => { root.update-scale(); }
                    }
                }
            }

            Rectangle {
                height: 50px;
                VerticalBox {
                    spacing: 4px;
                    padding: 0;
                    Text { text: "Scale Type"; color: #a1a1aa; font-size: 11px; }
                    ComboBox {
                        model: root.available-scales;
                        current-index <=> root.selected-scale-idx;
                        selected => { root.update-scale(); }
                    }
                }
            }

            if !root.is-all-roots-mode: Button {
                height: 44px;
                text: "Play Scale";
                clicked => { root.play-scale-sequence(); }
            }
        }
    }

    if !root.is-all-roots-mode: Flickable {
        vertical-stretch: 1;

        HorizontalBox {
            y: 0px;
            height: self.preferred-height;
            spacing: 10px;
            alignment: start;
            padding: 0;
            padding-top: 10px;

            for item in root.scale-notes: NoteCard {
                degree: item.degree;
                note: item.note;
                is-active: item.is-active;

                TouchArea {
                    clicked => { root.play-note(item.note); }
                }
            }
        }
    }

    if root.is-all-roots-mode: Flickable {
        vertical-stretch: 1;
        VerticalBox {
            y: 0px;
            height: self.preferred-height;
            spacing: 14px;
            padding: 0;
            padding-top: 6px;
            for row[row_idx] in root.all-scale-rows: VerticalBox {
                spacing: 4px;
                padding: 0;
                Text {
                    text: row.scale_name;
                    color: #38bdf8;
                    font-size: 13px;
                    font-weight: 600;
                }

                Flickable {
                    content-width: row.notes.length * 66px;
                    height: 75px;
                    HorizontalBox {
                        spacing: 6px;
                        alignment: start;
                        padding: 0;
                        for note_item[col_idx] in row.notes: NoteCard {
                            width: 60px;
                            height: 75px;
                            degree: note_item.degree;
                            note: note_item.note;
                            is-active: root.active-all-row == row_idx && root.active-all-col == col_idx;

                            TouchArea {
                                clicked => {
                                    root.active-all-row = row_idx;
                                    root.active-all-col = col_idx;
                                    root.play-note(note_item.note);
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}